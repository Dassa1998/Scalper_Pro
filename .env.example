# ============ MODE ============
APP_MODE=paper                  # paper | testnet | mainnet
CONFIRM_LIVE_TRADING=false      # MUST be true for mainnet

# ============ BINANCE ============
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_BASE_URL_MAINNET=https://fapi.binance.com
BINANCE_BASE_URL_TESTNET=https://demo-fapi.binance.com
BINANCE_WS_BASE_MAINNET=wss://fstream.binance.com
BINANCE_WS_BASE_TESTNET=wss://demo-fstream.binance.com

# ============ DATABASE ============
DATABASE_URL=sqlite+aiosqlite:///./scalper.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ============ AUTH ============
DASHBOARD_PASSWORD_HASH=        # bcrypt hash of your password
SECRET_KEY=                     # random 32+ chars
SESSION_COOKIE_SECURE=true

# ============ RISK (hard caps enforced in code) ============
RISK_PER_TRADE_PCT=0.5
MAX_RISK_PER_TRADE_PCT=2.0
SMALL_ACCOUNT_THRESHOLD=20.0
SMALL_ACCOUNT_MAX_RISK_PCT=5.0
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
CONSECUTIVE_LOSS_COOLDOWN=3

# ============ STRATEGY ============
DEFAULT_LEVERAGE=7
ATR_SL_MULTIPLIER=1.2
TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=2.0
SIGNAL_MIN_SCORE=60
AI_MIN_PROB=0.55
MAX_SLIPPAGE_PCT=0.15
COST_GATE_MULTIPLIER=3.0

# ============ TELEGRAM (optional) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
